# Desenvolvimento local. Nunca reutilize estas credenciais em produção.
DATABASE_URL=postgresql://splitfin:splitfin@localhost:5432/splitfin

# Usada por `pnpm test:db`; o nome precisa terminar com `_test`.
TEST_DATABASE_URL=postgresql://splitfin:splitfin@localhost:5432/splitfin_test

# Gere um valor exclusivo por ambiente com `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Mailpit local: caixa de entrada disponível em http://localhost:8025.
AUTH_SMTP_HOST=localhost
AUTH_SMTP_PORT=1025
AUTH_SMTP_SECURE=false
AUTH_EMAIL_FROM=Splitfin <no-reply@splitfin.local>
